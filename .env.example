# 全部可选。不配置时，应用使用内置课程与设备语音。
# 三个端点可以由任意模型、本地服务或自建工作流实现。
LECTURER_TEXT_ENDPOINT=
LECTURER_SPEECH_ENDPOINT=
LECTURER_TERM_ENDPOINT=

# 可选：不使用 Gemini，直接连接 OpenAI Speech API。
# OPENAI_API_KEY 仅在服务端读取；默认模型可按需替换。
OPENAI_API_KEY=
OPENAI_TTS_MODEL=gpt-4o-mini-tts

# 如果上游服务需要 Bearer Token，在服务端配置，不要写入前端代码。
LECTURER_PROVIDER_TOKEN=
