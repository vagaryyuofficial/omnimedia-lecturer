{
  "name": "deep-language-expert",
  "version": "0.3.0",
  "description": "Bilingual, multilingual dictionary, knowledge and speech-learning desktop application.",
  "private": true,
  "license": "MIT",
  "author": "Deep Language Expert contributors",
  "homepage": "https://github.com/vagaryyuofficial/omnimedia-lecturer",
  "repository": "https://github.com/vagaryyuofficial/omnimedia-lecturer.git",
  "main": "desktop/main.mjs",
  "packageManager": "pnpm@10.17.1",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "predev": "node scripts/sync-transformers-runtime.mjs",
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "prebuild": "node scripts/sync-transformers-runtime.mjs",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "desktop:dev": "pnpm run build && install-electron && electron .",
    "desktop:pack": "pnpm run build && electron-builder --dir",
    "desktop:dist": "pnpm run build && electron-builder",
    "desktop:icon": "node desktop/create-icon.mjs",
    "voice:runtime": "node scripts/sync-transformers-runtime.mjs",
    "test": "pnpm run build && node --test tests/*.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@eslint/js": "9.39.4",
    "@huggingface/transformers": "^4.2.0",
    "@next/eslint-plugin-next": "16.2.6",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-server-dom-webpack": "19.2.6",
    "sharp": "^0.35.3",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "vinext": "1.0.0-beta.2",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
